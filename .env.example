# ==========================================
# Konfigurasi Aplikasi
# ==========================================
APP_PORT=:8080
APP_PORT_HOST=8080

# ==========================================
# Konfigurasi Database PostgreSQL
# ==========================================
# Opsi 1: Menggunakan full connection URL (Prisma, Supabase, Neon, Railway, dll)
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Opsi 2: Konfigurasi parameter terpisah
# Di Docker Compose lokal, gunakan DB_HOST=db. Jika cloud DB (misal Prisma), gunakan host Prisma.
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=supersecretpassword
DB_NAME=undangan_db
DB_SSLMODE=disable

# Port PostgreSQL yang diexpose ke Host (opsional, jika menggunakan local postgres)
# DB_PORT_EXPOSE=127.0.0.1:5432

# ==========================================
# Konfigurasi JWT (JSON Web Token)
# ==========================================
JWT_SECRET=ganti_dengan_random_secret_key_yang_sangat_panjang_dan_aman
JWT_EXPIRES_IN=24h
JWT_ISSUER=api-undangan
JWT_AUDIENCE=api-undangan-users

# ==========================================
# Konfigurasi Mailtrap / Email Service
# ==========================================
MAILTRAP_TOKEN=your_mailtrap_token_here
MAILTRAP_FROM_EMAIL=no-reply@yourdomain.com
MAILTRAP_FROM_NAME=Admin Undangan
